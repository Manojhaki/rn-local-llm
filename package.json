{
  "name": "rn-local-llm",
  "version": "0.0.0",
  "private": true,
  "description": "Run a small language model on-device, offline, from React Native.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hashing": {
      "types": "./dist/hashing.d.ts",
      "default": "./dist/hashing.js"
    },
    "./download-transport": {
      "types": "./dist/downloadTransport.d.ts",
      "default": "./dist/downloadTransport.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "check": "npm run typecheck && npm run test && npm run build",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-file-system": "^57.0.2",
    "react-native-quick-crypto": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "expo-file-system": "57.0.2",
    "react-native-quick-crypto": "1.1.6",
    "typescript": "7.0.2"
  }
}
